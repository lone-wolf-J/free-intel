# Prospect Intelligence - Environment Variables
# Copy to .env and fill. All values are server-only (never use VITE_ prefix).

# Required - AI provider (at least one)
GROQ_API_KEY=
GEMINI_API_KEY=

# Search providers (tiered, quota-aware)
SERPER_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPAPI_KEY=
BING_API_KEY=

# Deep scrape providers (rotated per query)
SCRAPE_DO_KEY=
FIRECRAWL_API_KEY=
SCRAPINGBEE_API_KEY=
ZENROWS_API_KEY=

# Enrichment
EXPLORIUM_API_KEY=
TINYFISH_API_KEY=

# Optional - for future use
# SERPER_API_KEY is primary (2500/mo), TAVILY fallback (1000/mo)
# See SECURITY_AUDIT.md for rotation guidance

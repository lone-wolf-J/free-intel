{
  "name": "free-intel-api",
  "main": "server/index.ts",
  "compatibility_date": "2024-09-23",
  "rules": [
    { "type": "Text", "globs": ["**/*.sql"] }
  ],
  "triggers": {
    "crons": ["7 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "freeintel",
      "database_id": "freeintel-local"
    }
  ]
}

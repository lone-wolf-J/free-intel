# FREE//INTEL secrets — copy this file to ".env" and fill in what you have.
# Everything is optional; the platform runs without any of these,
# just with lighter discovery and heuristic-only classification.

# Free token: github.com → Settings → Developer settings → Personal access tokens.
# No scopes needed (public repos only). Raises discovery from 60 to 5,000 req/hr.
GITHUB_TOKEN=

# Free key: aistudio.google.com → Get API key. Enables live product resolution
# (e.g. typing "Claude" finds its official pricing page), pricing-plan
# extraction, and smarter capability tagging.
GEMINI_API_KEY=

# Protects POST /api/scans/run in production. Not needed locally.
CRON_SECRET=
